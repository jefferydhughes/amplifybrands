{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      },
      "continue": true
    },
    {
      "has": [{ "type": "host", "value": "realtors.amplifybrands.io" }],
      "src": "/",
      "dest": "/realtor.html",
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/([^/.]+)/?$", "dest": "/$1.html" }
  ]
}
